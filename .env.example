DATABASE_URL=sqlite:///pika.db
# DATABASE_URL=mysql+mysqlclient://user:pass@localhost/pika

OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_ENABLED=false
# OTEL_ENDPOINT=http://localhost:4317

PIKA_ENV=development

# Required when PIKA_ENV=production (fail-closed auth)
PIKA_API_KEY=
# X-Pika-Key header must match. Use: fly secrets set PIKA_API_KEY=...

# Identity headers (X-Tenant-ID / X-User-ID / X-Role). Default false in production.
# PIKA_TRUST_IDENTITY_HEADERS=true

# Opt into full span/Langfuse content (default truncates to 500 chars)
# PIKA_TRACE_FULL_CONTENT=false

# Docker compose mysql profile
# MYSQL_ROOT_PASSWORD=

# Shared with Hermes google-workspace tokens (default: ~/.hermes)
# PIKA_CREDENTIALS_DIR=~/.hermes-personal
# HERMES_HOME=~/.hermes-personal
